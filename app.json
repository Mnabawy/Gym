{
  "expo": {
    "name": "Brainy",
    "slug": "brainy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mnabawy.gym"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A2366",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mnabawy.gym",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6F9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E1318",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E8A5F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "التطبيق بيستخدم مكانك عشان يحسب مواقيت الصلاة."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "التطبيق بيستخدم الصور عشان تحفظ صور التقدم.",
          "cameraPermission": "التطبيق بيستخدم الكاميرا عشان تصوّر صور التقدم.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "التطبيق بيستخدم Face ID عشان محدش غيرك يفتحه."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "scheme": "gym",
    "experiments": {
      "typedRoutes": false
    }
  }
}
