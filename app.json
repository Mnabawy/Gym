{
  "expo": {
    "name": "Gym",
    "slug": "gym",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mnabawy.gym"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14181F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mnabawy.gym"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14181F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E8A5F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "التطبيق بيستخدم مكانك عشان يحسب مواقيت الصلاة."
        }
      ]
    ],
    "scheme": "gym",
    "experiments": {
      "typedRoutes": false
    }
  }
}